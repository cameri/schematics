# Copy to .env and fill in. Never commit the real .env (R-9).

# Cloudflare tunnel token (Zero Trust -> Tunnels -> your dedicated tunnel)
TUNNEL_TOKEN=

# 32-byte random token embedded in the webhook URL path (P-3):
#   openssl rand -hex 32
# GitHub's webhook URL must match https://<PUBLIC_HOSTNAME>/webhook/<WEBHOOK_TOKEN>
WEBHOOK_TOKEN=

# Docker API via the scoped socket proxy (leave as-is)
SOCKET_PROXY_URL=http://socket-proxy:2375

# Which repo push events to act on (P-4)
WATCHED_BRANCH=main

# Image to pull through the socket proxy (P-5, P-6)
TARGET_IMAGE=ghcr.io/yourorg/yourrepo
TARGET_TAG=main

TZ=UTC
