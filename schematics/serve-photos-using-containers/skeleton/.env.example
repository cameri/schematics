# Copy to .env in the project directory and fill every value.
# No secret belongs in a repository; this file is the template for one that
# stays on the host.

# --- Paths ------------------------------------------------------------------
# Originals plus all generated content. Big, local, backed up.
UPLOAD_LOCATION=/srv/immich/library
# The Postgres cluster. Local filesystem only; a network share is not usable.
DB_DATA_LOCATION=/srv/immich/postgres

# --- Images -----------------------------------------------------------------
# The release line you are deploying, e.g. release or a fixed version tag.
IMMICH_VERSION=release
# The tag the release names for its Postgres image (it carries the vector
# extension; a stock postgres image does not).
DB_IMAGE_TAG=
# The Valkey major version the release names.
CACHE_VERSION=
# Digests, 64 hex characters each, no "sha256:" prefix. Resolve each with:
#   docker buildx imagetools inspect <repository>:<tag>
SERVER_DIGEST=
ML_DIGEST=
DB_DIGEST=
CACHE_DIGEST=

# --- Database ---------------------------------------------------------------
DB_USERNAME=postgres
DB_DATABASE_NAME=immich
# Generate once and keep it out of version control, letters and digits only, e.g.
#   openssl rand -hex 24
# Changing it after the cluster exists does not change the role's password.
DB_PASSWORD=
# SSD (default) tunes Postgres for concurrent IO; set HDD for spinning disks.
DB_STORAGE_TYPE=SSD

# --- Cache ------------------------------------------------------------------
# Leave empty: the cache runs without authentication and is reachable only
# inside the project network. A password takes three edits, not one (P-27):
# the cache's command, its healthcheck, and this value.
REDIS_PASSWORD=

# --- Runtime ----------------------------------------------------------------
# A timezone identifier, e.g. Etc/UTC or Europe/Berlin.
TZ=Etc/UTC
# The port the server listens on inside the container; published only when
# EXPOSURE=localhost.
HTTP_PORT=2283
# private | localhost | tsdproxy | cloudflare
EXPOSURE=private
# The proxy's address or subnet when one fronts the server, otherwise empty.
IMMICH_TRUSTED_PROXIES=
# Close the sign-up endpoint once the first administrator exists.
IMMICH_ALLOW_SETUP=true

# --- Machine learning -------------------------------------------------------
# Request thread pool. Leave commented to use every core; set it below the core
# count on any host without thermal headroom. This is the first knob to tune.
# MACHINE_LEARNING_REQUEST_THREADS=4
# Worker processes. Each duplicates its models in memory.
MACHINE_LEARNING_WORKERS=1
# Seconds of inactivity before a model is unloaded and its memory returns.
MACHINE_LEARNING_MODEL_TTL=300
# A hard CPU ceiling for the machine-learning container, as a number of cores,
# e.g. 4.0. 0 or empty means no ceiling. This is the parameter that bounds the
# first index; leaving it empty is a decision, not a default.
ML_CPU_LIMIT=0
